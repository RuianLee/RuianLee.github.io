---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "astro:assets";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import featherIcon from "@/assets/icons/feather-pen.png";
import LinkButton from "./LinkButton.astro";
import Socials from "./Socials.astro";
import { stripBase, stripLocale } from "@/utils/withBase";
import { categories } from "@/config/categories";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;

// Strip the base prefix so isActive comparisons work regardless of deploy subdirectory.
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};

const sections = categories.map(({ slug, navLabel }) => ({
  path: slug,
  label: navLabel,
}));
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  跳到主要內容
</a>

<header class="header-layout">
  <!-- 置中站名
  <div class="pt-4 pb-2 text-center sm:pt-6 sm:pb-3">
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="font-display inline-flex items-center gap-2 text-4xl font-bold tracking-tight italic sm:text-5xl"
    >
      {site.title}
    </a>
    <div class="text-muted-foreground/40 mt-3 flex items-center justify-center gap-3" aria-hidden="true">
      <span class="h-px w-8 bg-current"></span>
      <span class="text-xs">Ｏ</span>
      <span class="h-px w-8 bg-current"></span>
    </div>
  </div> -->

  <!-- 導覽列（外框）：左側關於＋首頁＋分類、右側社群連結與深色模式切換 -->
  <nav
    id="nav-menu"
    class="border-border relative mt-1 flex items-center gap-1 border-y px-3 py-2.5 sm:mt-2 sm:gap-2"
  >
    <div class="flex min-w-0 flex-1 items-center gap-1 sm:absolute sm:top-1/2 sm:left-1/2 sm:w-max sm:flex-none sm:-translate-x-1/2 sm:-translate-y-1/2 sm:gap-2">
      <a
        href={getRelativeLocaleUrl(locale, "about")}
        class:list={[
          "nav-link shrink-0 rounded-md px-3 py-2 text-lg font-medium sm:px-4",
          { "active-nav": isActive("/about") },
        ]}
      >
        關於
      </a>
      <a
        href={getRelativeLocaleUrl(locale, "")}
        class:list={[
          "nav-link shrink-0 rounded-md px-4 py-2 text-lg font-medium",
          { "active-nav": currentPath === "/" },
        ]}
      >
        首頁
      </a>
      <button
        id="menu-btn"
        class="focus-outline p-2 sm:hidden"
        aria-label="開啟選單"
        aria-expanded="false"
        aria-controls="menu-items"
        data-label-open="開啟選單"
        data-label-close="關閉選單"
      >
        <IconX id="close-icon" class="hidden" />
        <IconMenuDeep id="menu-icon" />
      </button>
      <ul
        id="menu-items"
        class="border-border bg-background absolute inset-x-0 top-full z-10 hidden flex-col gap-1 rounded-xl border p-2 sm:static sm:flex sm:flex-row sm:items-center sm:gap-2 sm:border-0 sm:bg-transparent sm:p-0"
      >
        {
          sections.map(({ path, label }) => (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, path)}
                class:list={[
                  "nav-link block rounded-md px-4 py-2 text-center text-lg font-medium",
                  { "active-nav": isActive(`/${path}`) },
                ]}
              >
                {label}
              </a>
            </li>
          ))
        }
        {
          features.search !== false && (
            <li class="flex items-center justify-center ps-2">
              <LinkButton
                href={getRelativeLocaleUrl(locale, "search")}
                class:list={["focus-outline relative size-10"]}
                title="搜尋"
                aria-label="搜尋"
              >
                <IconSearch class="absolute top-1/2 left-1/2 size-6 -translate-x-1/2 -translate-y-1/2" />
                <span class="sr-only">搜尋</span>
              </LinkButton>
            </li>
          )
        }
      </ul>
    </div>

    <div class="ml-auto flex shrink-0 items-center gap-3">
      <Socials />
      {
        features.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="focus-outline hover:text-foreground relative size-8"
            title="切換深色/淺色模式"
            aria-label="auto"
            aria-live="polite"
          >
            <IconMoon class="absolute top-[50%] left-[50%] size-8 translate-[-50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
            <IconSunHigh class="absolute top-[50%] left-[50%] size-8 translate-[-50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
          </button>
        )
      }
    </div>
  </nav>
</header>

<script>
  function setupToggle(
    btnId: string,
    menuId: string,
    openIconId: string,
    closeIconId: string
  ) {
    const btn = document.querySelector<HTMLButtonElement>(btnId);
    const menu = document.querySelector(menuId);
    const openIcon = document.querySelector(openIconId);
    const closeIcon = document.querySelector(closeIconId);

    if (!btn || !menu || !openIcon || !closeIcon) return;

    const openLabel = btn.dataset.labelOpen ?? "Open menu";
    const closeLabel = btn.dataset.labelClose ?? "Close menu";

    btn.addEventListener("click", () => {
      const openMenu = btn.getAttribute("aria-expanded") === "true";

      btn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      btn.setAttribute("aria-label", openMenu ? openLabel : closeLabel);

      menu.classList.toggle("hidden");
      menu.classList.toggle("flex");
      openIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  function setupNavToggles() {
    setupToggle("#menu-btn", "#menu-items", "#menu-icon", "#close-icon");
  }

  setupNavToggles();

  document.addEventListener("astro:after-swap", setupNavToggles);
</script>

<style>
  #nav-menu {
    box-shadow: 0 1px 2px color-mix(in oklab, var(--foreground) 6%, transparent);
  }

  .nav-link {
    position: relative;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    inset-inline: 0.75rem;
    bottom: 0.375rem;
    border-bottom: 2px dashed var(--accent);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.25s ease;
  }

  .nav-link:hover::after,
  .nav-link.active-nav::after {
    transform: scaleX(1);
  }
</style>
