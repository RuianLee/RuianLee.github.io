---
import { getRelativeLocaleUrl } from "astro:i18n";
import Sidebar from "./Sidebar.astro";
import config from "@/config";

type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  class?: string;
  /** When set, renders the category/avatar sidebar next to a title card instead of a plain heading. */
  sidebarCategories?: { path: string; label: string; count: number }[];
  sidebarTags?: string[];
  /** Hide the plain `<h1>{pageTitle}</h1>` heading (ignored when sidebarCategories is set). Defaults to true. */
  showTitle?: boolean;
};

const {
  pageTitle,
  pageDesc,
  class: className,
  sidebarCategories,
  sidebarTags,
  showTitle = true,
} = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const backUrl = config.features.showBackButton
  ? Astro.url.pathname
  : getRelativeLocaleUrl(locale, "");
---

<main
  data-backUrl={backUrl}
  id="main-content"
  class:list={["app-layout pt-6 pb-4 sm:pt-8", className]}
>
  {
    sidebarCategories ? (
      <>
        <div class="border-border mb-10 border-t border-b border-dashed py-6 text-center">
          <h1 class="text-2xl font-bold sm:text-3xl">{pageTitle}</h1>
          <div class="bg-accent mx-auto mt-3 h-0.5 w-12 rounded-full" />
          {pageDesc && (
            <p class="text-muted-foreground mt-4 text-sm italic">
              {pageDesc}
            </p>
          )}
        </div>
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-[280px_1fr]">
          <Sidebar
            locale={locale}
            categories={sidebarCategories}
            tags={sidebarTags}
          />
          <div>
            <slot />
          </div>
        </div>
      </>
    ) : (
      <>
        {showTitle && (
          <>
            <h1 class="text-2xl font-semibold sm:text-3xl">{pageTitle}</h1>
            <p class="mt-2 mb-6 italic">{pageDesc}</p>
          </>
        )}
        <slot />
      </>
    )
  }
</main>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
