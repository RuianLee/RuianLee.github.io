---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import Sidebar from "./Sidebar.astro";
import config from "@/config";

type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  class?: string;
  /** When set, renders the category/avatar sidebar next to a title card instead of a plain heading. */
  sidebarCategories?: { path: string; label: string; count: number }[];
  sidebarTags?: string[];
  /** Hide the plain `<h1>{pageTitle}</h1>` heading (ignored when sidebarCategories is set). Defaults to true. */
  showTitle?: boolean;
  /** Background photo for the sidebarCategories header, styled like a HeroCarousel slide. */
  coverImage?: ImageMetadata;
};

const {
  pageTitle,
  pageDesc,
  class: className,
  sidebarCategories,
  sidebarTags,
  showTitle = true,
  coverImage,
} = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const backUrl = config.features.showBackButton
  ? Astro.url.pathname
  : getRelativeLocaleUrl(locale, "");
---

<main
  data-backUrl={backUrl}
  id="main-content"
  class:list={["app-layout pt-6 pb-4 sm:pt-8", className]}
>
  {
    sidebarCategories ? (
      <>
        <div class="full-bleed relative mb-10 overflow-hidden">
          {coverImage ? (
            <Image
              src={coverImage}
              alt=""
              class="absolute inset-0 h-full w-full object-cover"
            />
          ) : (
            <div class="media-placeholder absolute inset-0" />
          )}
          <div class="relative p-10 sm:p-24">
            <div class="glass-panel mx-auto max-w-2xl rounded-xl p-8 text-center sm:p-12">
              <h1 class="text-2xl font-bold sm:text-3xl">{pageTitle}</h1>
              {pageDesc && (
                <p class="text-muted-foreground mt-4 text-sm">{pageDesc}</p>
              )}
            </div>
          </div>
        </div>
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-[280px_1fr]">
          <Sidebar
            locale={locale}
            categories={sidebarCategories}
            tags={sidebarTags}
          />
          <div>
            <slot />
          </div>
        </div>
      </>
    ) : (
      <>
        {showTitle && (
          <>
            <h1 class="text-2xl font-semibold sm:text-3xl">{pageTitle}</h1>
            <p class="mt-2 mb-6 italic">{pageDesc}</p>
          </>
        )}
        <slot />
      </>
    )
  }
</main>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
