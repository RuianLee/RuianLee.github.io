---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";
import IconUser from "@/assets/icons/IconUser.svg";
import config from "@/config";

type Props = {
  variant?: "h2" | "h3";
  href: string;
  title: string;
  description: string;
  pubDatetime: Date;
  modDatetime?: Date | null;
  timezone?: string;
  coverImage?: ImageMetadata;
};

const {
  variant: Heading = "h2",
  href,
  title,
  description,
  pubDatetime,
  modDatetime,
  timezone,
  coverImage,
} = Astro.props;
---

<li class="border-muted-foreground/40 flex flex-col gap-4 overflow-hidden border-b border-dashed py-6 last:border-none last:pb-0 sm:relative sm:h-65">
  {
    coverImage ? (
      <div class="w-full flex-none sm:absolute sm:inset-y-0 sm:left-0 sm:flex sm:w-55 sm:items-center sm:justify-center">
        <Image
          src={coverImage}
          alt=""
          width={480}
          height={480}
          class="aspect-video w-full rounded-xl object-cover sm:aspect-square sm:h-55 sm:w-60"
        />
      </div>
    ) : (
      <div class="w-full flex-none sm:absolute sm:inset-y-0 sm:left-0 sm:flex sm:w-56 sm:items-center sm:justify-center">
        <div class="media-placeholder aspect-video w-full rounded-xl sm:aspect-square sm:h-52 sm:w-60" />
      </div>
    )
  }
  <div class="min-w-0 overflow-hidden sm:pl-60">
    <a
      href={href}
      class:list={[
        "block text-lg font-bold",
        "underline-offset-4 hover:underline",
        "focus-visible:no-underline focus-visible:underline-offset-0",
      ]}
    >
      <Heading class="truncate" transition:name={toTransitionName(title)}>
        {title}
      </Heading>
    </a>
    <div class="text-muted-foreground mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
      <span class="flex items-center gap-1.5">
        <IconUser class="size-4" />
        {config.site.author}
      </span>
      <Datetime {pubDatetime} {modDatetime} {timezone} />
    </div>
    <p class="mt-2 line-clamp-3">{description}</p>
    <a
      href={href}
      class="border-muted-foreground/40 hover:border-accent hover:text-accent mt-3 inline-block border border-dashed px-4 py-2 text-sm font-medium transition-colors"
    >
      閱讀更多
    </a>
  </div>
</li>
