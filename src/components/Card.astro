---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";
import IconUser from "@/assets/icons/IconUser.svg";
import config from "@/config";

type Props = {
  variant?: "h2" | "h3";
  href: string;
  title: string;
  description: string;
  pubDatetime: Date;
  modDatetime?: Date | null;
  timezone?: string;
  coverImage?: ImageMetadata;
};

const {
  variant: Heading = "h2",
  href,
  title,
  description,
  pubDatetime,
  modDatetime,
  timezone,
  coverImage,
} = Astro.props;
---

<li
  class="
    glass-panel
    mb-6
    last:mb-0
    flex flex-col
    gap-0
    overflow-hidden
    rounded-xl
    p-0
    lg:flex-row
  "
>
  {  
    coverImage ? (
      <div class="w-full flex-none overflow-hidden lg:w-96 lg:shrink-0 lg:self-stretch">
        <Image
          src={coverImage}
          alt=""
          width={640}
          height={360}
          class="aspect-video w-full object-cover object-center lg:h-full lg:aspect-auto"
        />
      </div>
    ) : (
      <div class="w-full flex-none overflow-hidden lg:w-96 lg:shrink-0 lg:self-stretch">
        <div class="media-placeholder aspect-video w-full lg:h-full" />
      </div>
    )
  }
  <div class="flex min-w-0 flex-1 flex-col justify-between p-6 sm:p-8 lg:min-h-0">
    <div>
      <a
        href={href}
        class:list={[
          "block text-xl font-bold leading-tight sm:text-2xl text-foreground",
          "underline-offset-4 hover:underline",
          "focus-visible:no-underline focus-visible:underline-offset-0",
        ]}
      >
        <Heading transition:name={toTransitionName(title)}>
          {title}
        </Heading>
      </a>
      <div class="text-muted-foreground mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm sm:text-base">
      <span class="flex items-center gap-1.5">
        <IconUser class="size-4" />
          <span class="text-muted-foreground">{config.site.author}</span>
      </span>
      <Datetime {pubDatetime} {modDatetime} {timezone} />
    </div>
      <p class="text-muted-foreground mt-3 text-lg sm:text-xl">{description}</p>
    </div>
    <a
      href={href}
      class="mt-4 self-end inline-flex border border-dashed border-muted-foreground/50 text-muted-foreground px-6 py-3 text-base font-medium transition-colors hover:border-accent hover:text-accent w-fit"
    >
      Read More
    </a>
  </div>
</li>
