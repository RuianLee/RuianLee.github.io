---
import type { HTMLAttributes } from "astro/types";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "astro:assets";
import Socials from "./Socials.astro";
import Datetime from "./Datetime.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import { getCoverImage } from "@/utils/getCoverImage";
import { toTransitionName } from "@/utils/toTransitionName";
import { categories } from "@/config/categories";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const currentYear = new Date().getFullYear();
const locale = Astro.currentLocale ?? config.site.lang;

const posts = await getCollection("blog", ({ data }) => !data.draft);
const featuredPosts = getSortedPosts(posts).slice(0, 3);

const footerLinks = [
  { label: "關於", href: getRelativeLocaleUrl(locale, "about") },
  ...categories.map(({ slug, navLabel }) => ({
    label: navLabel,
    href: getRelativeLocaleUrl(locale, slug),
  })),
  { label: "搜尋", href: getRelativeLocaleUrl(locale, "search") },
];
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="border-border grid gap-10 border-t py-10 sm:grid-cols-2 sm:gap-16">
    <div>
      <h2 class="text-lg font-bold">關於本站</h2>
      <p class="text-muted-foreground mt-3 max-w-sm">
        {config.site.description}
      </p>
      <div class="mt-4"><Socials /></div>
    </div>

    {
      featuredPosts.length > 0 && (
        <div>
          <h2 class="text-lg font-bold">精選文章</h2>
          <ul class="mt-3 flex flex-col gap-4">
            {featuredPosts.map(post => {
              const cover = getCoverImage(post.data.coverImage);
              const href = getPostUrl(post.id, post.filePath, locale);
              return (
                <li>
                  <a href={href} class="group flex items-center gap-3">
                    {cover ? (
                      <Image
                        src={cover}
                        alt=""
                        width={128}
                        height={128}
                        class="aspect-square w-16 flex-none rounded-lg object-cover"
                      />
                    ) : (
                      <div class="media-placeholder aspect-square w-16 flex-none rounded-lg" />
                    )}
                    <div class="min-w-0">
                      <div
                        class="line-clamp-2 font-medium group-hover:underline"
                        transition:name={toTransitionName(post.data.title)}
                      >
                        {post.data.title}
                      </div>
                      <Datetime
                        pubDatetime={post.data.pubDatetime}
                        modDatetime={post.data.modDatetime}
                        timezone={post.data.timezone}
                      />
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      )
    }
  </div>

  <div
    class="border-border flex flex-col items-center gap-4 border-t py-6 sm:flex-row sm:justify-between sm:py-4"
  >
    <nav class="flex flex-wrap justify-center gap-x-4 gap-y-1 text-sm">
      {
        footerLinks.map(({ label, href }) => (
          <a href={href} class="text-muted-foreground hover:text-foreground">
            {label}
          </a>
        ))
      }
    </nav>
    <div class="flex flex-col items-center whitespace-nowrap sm:flex-row">
      <span>版權所有 &#169; {currentYear}</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <span>保留一切權利。</span>
    </div>
  </div>
</footer>
