---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Sidebar from "@/components/Sidebar.astro";
import Card from "@/components/Card.astro";
import HeroCarousel from "@/components/HeroCarousel.astro";
import { getAggregatedItems } from "@/utils/getAggregatedItems";
import { getCategorySummaries } from "@/utils/getCategorySummaries";
import config from "@/config";

export async function getStaticPaths() {
  const allItems = await getAggregatedItems(config.site.lang);
  const tags = [...new Set(allItems.flatMap(item => item.tags))];
  return tags.map(tag => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props as { tag: string };
const locale = Astro.currentLocale ?? config.site.lang;

const allItems = await getAggregatedItems(locale);
const items = allItems.filter(item => item.tags.includes(tag));

const heroSlides = items.slice(0, 3);

const sidebarCategories = await getCategorySummaries();
const sidebarTags = [...new Set(allItems.flatMap(item => item.tags))];
---

<Layout title={`${tag} | ${config.site.title}`}>
  <Header />
  <main data-backurl={Astro.url.pathname} id="main-content" class="app-layout">
    <HeroCarousel slides={heroSlides} />

    <div class="grid grid-cols-1 gap-10 mt-10 lg:grid-cols-[280px_1fr]">
      <Sidebar locale={locale} categories={sidebarCategories} tags={sidebarTags} />

      <section id="latest-post">
        <h2 class="border-muted-foreground/40 border-b border-dashed pb-3 text-xl font-bold">
          {tag}
        </h2>
        <ul>
          {
            items.map(({ title, description, pubDatetime, href, coverImage }) => (
              <Card
                variant="h3"
                href={href}
                title={title}
                description={description}
                pubDatetime={pubDatetime}
                coverImage={coverImage}
              />
            ))
          }
        </ul>
      </section>
    </div>
  </main>
  <Footer/>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null = document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
