---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getCategorySummaries } from "@/utils/getCategorySummaries";
import { getCoverImage } from "@/utils/getCoverImage";
import { genericCategories, type CategoryDef } from "@/config/categories";
import config from "@/config";

/** Fields any generic category entry might carry, across collection schemas. */
type GenericData = {
  title: string;
  description: string;
  pubDatetime: Date;
  modDatetime?: Date | null;
  coverImage?: string;
};

export function getStaticPaths() {
  return genericCategories.map(category => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props as { category: CategoryDef };
const locale = Astro.currentLocale ?? config.site.lang;

const entries = await getCollection(category.slug);
const items = getSortedPosts(entries) as { id: string; data: GenericData }[];
const sidebarCategories = await getCategorySummaries();
---

<Layout title={`${category.pageTitle} | ${config.site.title}`}>
  <Header />

  <Main
    pageTitle={category.pageTitle}
    pageDesc={category.pageDesc}
    sidebarCategories={sidebarCategories}
    coverImage={getCoverImage(items[0]?.data.coverImage)}
  >
    <ul>
      {
        items.map(({ id, data }) => (
          <Card
            href={getRelativeLocaleUrl(locale, `${category.slug}/${id}`)}
            title={data.title}
            description={data.description}
            pubDatetime={data.pubDatetime}
            modDatetime={data.modDatetime}
            coverImage={getCoverImage(data.coverImage)}
          />
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
