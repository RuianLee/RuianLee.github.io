---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import { genericCategories, type CategoryDef } from "@/config/categories";
import config from "@/config";

/** Fields any generic category entry might carry, across collection schemas. */
type GenericData = {
  title: string;
  description: string;
  pubDatetime: Date;
  modDatetime?: Date | null;
  tags?: string[];
  bookTitle?: string;
  bookAuthor?: string;
};

export function getStaticPaths() {
  return genericCategories.map(category => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props as { category: CategoryDef };
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const entries = await getCollection(category.slug);
const items = getSortedPosts(entries) as { id: string; data: GenericData }[];
---

<Layout title={`${t.pages[category.titleKey]} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages[category.titleKey]} pageDesc={t.pages[category.descKey]}>
    {
      category.layout === "grid" ? (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          {items.map(({ id, data }) => (
            <a
              href={getRelativeLocaleUrl(locale, `${category.slug}/${id}`)}
              class="card-box flex flex-col gap-3"
            >
              <h2 class="text-xl font-bold">{data.title}</h2>
              <p class="text-muted-foreground text-sm">{data.description}</p>
              {data.tags && data.tags.length > 0 && (
                <ul class="mt-auto flex flex-wrap gap-2 pt-2">
                  {data.tags.map(tag => (
                    <li class="bg-muted text-muted-foreground rounded-full px-2.5 py-0.5 text-xs">
                      {tag}
                    </li>
                  ))}
                </ul>
              )}
            </a>
          ))}
        </div>
      ) : (
        <ul>
          {items.map(({ id, data }) => (
            <Card
              href={getRelativeLocaleUrl(locale, `${category.slug}/${id}`)}
              title={data.title}
              description={data.description}
              pubDatetime={data.pubDatetime}
              modDatetime={data.modDatetime}
              meta={
                data.bookTitle && data.bookAuthor
                  ? `《${data.bookTitle}》－${data.bookAuthor}`
                  : undefined
              }
            />
          ))}
        </ul>
      )
    }
  </Main>

  <Footer />
</Layout>
