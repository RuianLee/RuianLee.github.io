---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import IconUser from "@/assets/icons/IconUser.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import { categories as categoryDefs } from "@/config/categories";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const homePath = getRelativeLocaleUrl(locale, "");

const categoryEntries = await Promise.all(
  categoryDefs.map(({ slug }) => getCollection(slug))
);
const categorySorted = categoryEntries.map(getSortedPosts);

type AggregatedItem = {
  title: string;
  description: string;
  pubDatetime: Date;
  href: string;
};

function toAggregated(
  entries: { id: string; filePath?: string; data: { title: string; description: string; pubDatetime: Date } }[],
  collection: string
): AggregatedItem[] {
  return entries.map(({ id, filePath, data }) => ({
    title: data.title,
    description: data.description,
    pubDatetime: data.pubDatetime,
    href:
      collection === "blog"
        ? getPostUrl(id, filePath, locale)
        : getRelativeLocaleUrl(locale, `${collection}/${id}`),
  }));
}

const allItems = categoryDefs
  .flatMap(({ slug }, i) => toAggregated(categorySorted[i], slug))
  .sort((a, b) => b.pubDatetime.getTime() - a.pubDatetime.getTime());

const heroSlides = allItems.slice(0, 3);

const categories = categoryDefs
  .map(({ slug, homeDescKey }, i) => ({
    path: slug,
    label: t.home[homeDescKey],
    count: categorySorted[i].length,
  }))
  .sort((a, b) => b.count - a.count);

const portfolioSorted = categorySorted[categoryDefs.findIndex(c => c.slug === "portfolio")] ?? [];
const tags = [
  ...new Set(
    portfolioSorted.flatMap(({ data }) => ("tags" in data ? data.tags : []))
  ),
];

const dateFormatter = new Intl.DateTimeFormat(locale, {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    {
      heroSlides.length > 0 && (
        <section
          id="hero-carousel"
          class="media-placeholder relative mt-8 overflow-hidden"
        >
          {heroSlides.map(({ title, description, pubDatetime, href }, i) => (
            <div
              data-slide
              class:list={["p-10 sm:p-24", { hidden: i !== 0 }]}
            >
              <div class="bg-background mx-auto max-w-lg p-8 text-center shadow-sm sm:p-10">
                <p class="text-muted-foreground text-sm tracking-wide uppercase">
                  {dateFormatter.format(pubDatetime)}
                </p>
                <h2 class="mt-3 text-2xl font-bold sm:text-3xl">{title}</h2>
                <p class="text-muted-foreground mt-4 text-sm">{description}</p>
                <a
                  href={href}
                  class="bg-muted mt-6 inline-block px-5 py-2.5 text-sm font-medium hover:opacity-80"
                >
                  閱讀更多
                </a>
              </div>
            </div>
          ))}

          {heroSlides.length > 1 && (
            <>
              <button
                type="button"
                data-carousel-prev
                aria-label={t.a11y.goToPreviousPage}
                class="bg-background/80 focus-outline absolute top-1/2 left-3 flex size-9 -translate-y-1/2 items-center justify-center rounded-full sm:left-5"
              >
                <IconArrowLeft class="size-4 rtl:rotate-180" />
              </button>
              <button
                type="button"
                data-carousel-next
                aria-label={t.a11y.goToNextPage}
                class="bg-background/80 focus-outline absolute top-1/2 right-3 flex size-9 -translate-y-1/2 items-center justify-center rounded-full sm:right-5"
              >
                <IconArrowRight class="size-4 rtl:rotate-180" />
              </button>
              <div class="absolute bottom-4 left-1/2 flex -translate-x-1/2 gap-2">
                {heroSlides.map((_, i) => (
                  <button
                    type="button"
                    data-carousel-dot
                    aria-label={`slide ${i + 1}`}
                    class:list={[
                      "size-2 rounded-full transition-colors",
                      i === 0 ? "bg-foreground" : "bg-foreground/25",
                    ]}
                  />
                ))}
              </div>
            </>
          )}
        </section>
      )
    }

    <div class="grid grid-cols-1 gap-10 mt-10 lg:grid-cols-[280px_1fr]">
      <aside class="flex flex-col gap-8">
        <div class="border-border rounded-xl border p-6 text-center">
          <div class="media-placeholder text-foreground mx-auto flex size-20 items-center justify-center rounded-full text-2xl font-bold">
            {config.site.author.slice(0, 1)}
          </div>
          <p class="mt-4 text-lg font-bold">{config.site.author}</p>
          <p class="text-muted-foreground mt-2 text-sm">{config.site.description}</p>
          <div class="mt-4 flex justify-center">
            <Socials />
          </div>
        </div>

        <div class="border-border rounded-xl border p-6">
          <h2 class="font-bold">分類</h2>
          <ul class="border-border mt-3 divide-y">
            {
              categories.map(({ path, label, count }) => (
                <li>
                  <a
                    href={getRelativeLocaleUrl(locale, path)}
                    class="hover:text-muted-foreground flex items-center justify-between py-2 text-sm"
                  >
                    <span>{label}</span>
                    <span class="text-muted-foreground">({count})</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        {tags.length > 0 && (
          <div class="border-border rounded-xl border p-6">
            <h2 class="font-bold">標籤</h2>
            <ul class="mt-3 flex flex-wrap gap-2">
              {tags.map(tag => (
                <li class="bg-muted rounded-full px-2.5 py-0.5 text-xs">{tag}</li>
              ))}
            </ul>
          </div>
        )}
      </aside>

      <section id="latest-post">
        <h2 class="border-border border-b pb-3 text-xl font-bold">最新文章</h2>
        <div class="mt-6 flex flex-col gap-8">
          {
            allItems.map(({ title, description, pubDatetime, href }) => (
              <a href={href} class="group flex flex-col gap-4 sm:flex-row">
                <div class="media-placeholder aspect-video w-full flex-none rounded-xl sm:w-56" />
                <div class="flex flex-col justify-center gap-2">
                  <h3 class="text-lg font-bold group-hover:underline">{title}</h3>
                  <div class="text-muted-foreground flex items-center gap-4 text-sm">
                    <span class="flex items-center gap-1.5">
                      <IconUser class="size-4" />
                      {config.site.author}
                    </span>
                    <span class="flex items-center gap-1.5">
                      <IconCalendar class="size-4" />
                      {dateFormatter.format(pubDatetime)}
                    </span>
                  </div>
                  <p class="text-muted-foreground text-sm">{description}</p>
                </div>
              </a>
            ))
          }
        </div>
      </section>
    </div>

    <section id="category-grid" class="py-10">
      <div class="flex snap-x snap-mandatory gap-4 overflow-x-auto pb-3 sm:gap-5">
        {
          categories.map(({ path, label }) => (
            <a
              href={getRelativeLocaleUrl(locale, path)}
              class="media-placeholder flex aspect-[4/3] w-36 flex-none snap-start flex-col items-center justify-center gap-2 rounded-xl text-center brightness-100 transition-[filter] hover:brightness-95 sm:w-44"
            >
              <span class="rounded-lg bg-background px-4 py-2 text-base font-bold shadow-sm sm:text-lg">
                {label}
              </span>
            </a>
          ))
        }
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });

  function initCarousel() {
    const root = document.querySelector<HTMLElement>("#hero-carousel");
    if (!root) return;

    const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-slide]"));
    const dots = Array.from(root.querySelectorAll<HTMLElement>("[data-carousel-dot]"));
    const prevBtn = root.querySelector<HTMLElement>("[data-carousel-prev]");
    const nextBtn = root.querySelector<HTMLElement>("[data-carousel-next]");
    if (slides.length === 0) return;

    let index = 0;

    function render() {
      slides.forEach((slide, i) => slide.classList.toggle("hidden", i !== index));
      dots.forEach((dot, i) => {
        dot.classList.toggle("bg-foreground", i === index);
        dot.classList.toggle("bg-foreground/25", i !== index);
      });
    }

    prevBtn?.addEventListener("click", () => {
      index = (index - 1 + slides.length) % slides.length;
      render();
    });
    nextBtn?.addEventListener("click", () => {
      index = (index + 1) % slides.length;
      render();
    });
    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => {
        index = i;
        render();
      });
    });
  }

  initCarousel();
  document.addEventListener("astro:after-swap", initCarousel);
</script>
