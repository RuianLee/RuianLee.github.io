---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Sidebar from "@/components/Sidebar.astro";
import Card from "@/components/Card.astro";
import HeroCarousel from "@/components/HeroCarousel.astro";
import { getAggregatedItems } from "@/utils/getAggregatedItems";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { categories as categoryDefs } from "@/config/categories";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const homePath = getRelativeLocaleUrl(locale, "");

const categoryEntries = await Promise.all(
  categoryDefs.map(({ slug }) => getCollection(slug))
);
const categorySorted = categoryEntries.map(getSortedPosts);

const allItems = await getAggregatedItems(locale);

const heroSlides = allItems.slice(0, 3);

const categories = categoryDefs
  .map(({ slug, homeDesc }, i) => ({
    path: slug,
    label: homeDesc,
    count: categorySorted[i].length,
  }))
  .sort((a, b) => b.count - a.count);

const tags = [...new Set(allItems.flatMap(item => item.tags))];
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <HeroCarousel slides={heroSlides} />

    <div class="grid grid-cols-1 gap-10 mt-10 lg:grid-cols-[280px_1fr]">
      <Sidebar locale={locale} categories={categories} tags={tags} />

      <section id="latest-post">
        <h2 class="border-muted-foreground/40 border-b border-dashed pb-3 text-xl font-bold">
          最新文章
        </h2>
        <ul>
          { 
            allItems.map(({ title, description, pubDatetime, href, coverImage }) => (
              <Card
                variant="h3"
                href={href}
                title={title}
                description={description}
                pubDatetime={pubDatetime}
                coverImage={coverImage}
              />
            ))
          }
        </ul>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
