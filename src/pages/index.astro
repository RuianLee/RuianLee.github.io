---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("blog");
const recentPosts = getSortedPosts(posts).slice(0, postsConfig.perIndex);
const homePath = getRelativeLocaleUrl(locale, "");

const categories = [
  {
    path: "portfolio",
    glyph: t.home.categoryPortfolio,
    label: t.home.categoryPortfolioDesc,
  },
  {
    path: "blog",
    glyph: t.home.categoryBlog,
    label: t.home.categoryBlogDesc,
  },
  {
    path: "journal",
    glyph: t.home.categoryJournal,
    label: t.home.categoryJournalDesc,
  },
  {
    path: "faith",
    glyph: t.home.categoryFaith,
    label: t.home.categoryFaithDesc,
  },
];
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1
        class="font-heading my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl"
      >
        {config.site.title}
      </h1>
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p>{t.home.intro}</p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    <section id="category-grid" class="border-border border-b py-10">
      <div class="grid grid-cols-2 gap-4 sm:gap-6 md:grid-cols-4">
        {
          categories.map(({ path, glyph, label }) => (
            <a
              href={getRelativeLocaleUrl(locale, path)}
              class="group flex flex-col items-center gap-3 py-4 hover:opacity-90"
            >
              <span class="stamp-box font-heading size-20 rounded-sm text-4xl group-hover:bg-accent/5 sm:size-24 sm:text-5xl">
                {glyph}
              </span>
              <span class="font-medium">{label}</span>
            </a>
          ))
        }
      </div>
    </section>

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="font-heading text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.map(({ id, data, filePath }) => (
              <Card
                variant="h3"
                href={getPostUrl(id, filePath, locale)}
                title={data.title}
                description={data.description}
                pubDatetime={data.pubDatetime}
                modDatetime={data.modDatetime}
                timezone={data.timezone}
              />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "blog")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
